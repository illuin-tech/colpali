# Never sync local benchmark artifacts up to the cluster. The cluster regenerates
# them; uploading stale results risks pulling a previous run's numbers back down
# and mistaking them for fresh output.
bench_lik/results/
bench_lik/run_output/
bench_lik/run_output_docvqa/

# Heavy / irrelevant local-only dirs.
# NOTE: do NOT exclude .git/ — the package uses hatchling VCS versioning, so the
# editable install on the cluster needs the git metadata to compute its version.
.venv/
data_dir/
**/__pycache__/
